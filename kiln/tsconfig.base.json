{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@glassworks/*": ["./packages/*/src/index.ts"],
      "@glassworks/brand/tokens.css": ["./packages/brand/src/tokens.css"],
      "@glassworks/brand/icon-kiln.svg": ["./packages/brand/src/icon-kiln.svg"],
      "@glassworks/fel/transport": ["./packages/fel/src/transport.ts"],
      "@glassworks/fel/fakes": ["./packages/fel/test/fakes.ts"],
      "@glassworks/setup-channel": ["./packages/setup-channel/src/channel.ts"],
      "improv-serial": ["./packages/improv-serial/src/index.ts"],
      "improv-serial/adb": ["./packages/improv-serial/src/adb.ts"],
      "vitest": ["./node_modules/vitest"]
    }
  }
}
