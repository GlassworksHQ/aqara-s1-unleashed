{
  "name": "s1-unleashed-web-installer",
  "private": true,
  "version": "0.0.0",
  "description": "Browser (WebUSB) installer for the Aqara Panel Hub S1 Plus. See docs/research/web-installer.md.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stage": "node scripts/stage-assets.mjs",
    "vercel-build": "node scripts/stage-assets.mjs --remote && npm run build"
  },
  "dependencies": {
    "@glassworks/adb": "0.0.0",
    "@glassworks/aqara-s1-plus-installer": "0.0.0",
    "@glassworks/bootpatch": "0.0.0",
    "@glassworks/fastboot": "0.0.0",
    "@glassworks/fel": "0.0.0",
    "@glassworks/kiln-core": "0.0.0",
    "@glassworks/setup-channel": "0.0.0",
    "improv-serial": "0.1.0"
  }
}
