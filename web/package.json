{
  "name": "s1-unleashed-web-installer",
  "private": true,
  "version": "0.0.0",
  "description": "Browser (WebUSB) installer for the Aqara Panel Hub S1 Plus. See docs/web-installer.md.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stage": "node scripts/stage-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/w3c-web-usb": "^1.0.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "2.6.1"
  }
}
