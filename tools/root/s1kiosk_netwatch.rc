# S1 Kiosk network watchdog (tools/root/s1kiosk_netwatch.sh), injected by Magisk as
# overlay.d/s1kiosk_netwatch.rc; the script ships in overlay.d/sbin (${MAGISKTMP}).
service s1kiosk_netwatch /system/bin/sh ${MAGISKTMP}/s1kiosk_netwatch.sh
    user root
    group root system
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start s1kiosk_netwatch
