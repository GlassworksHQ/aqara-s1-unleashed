# S1 Kiosk root install service (tools/root/s1kiosk_update.sh), injected by Magisk as
# overlay.d/s1kiosk_update.rc; the script ships in overlay.d/sbin (${MAGISKTMP}). Disabled one-shot:
# the app starts it after downloading and verifying an update (app/kiosk/.../update/UpdateManager.kt).
#
# App side: write /data/data/sh.edm.s1kiosk/files/update/pending.apk (private dir, kiosk uid only)
#           setprop sys.s1kiosk.update.status requested
#           setprop ctl.start s1kiosk_update
# Service side: sys.s1kiosk.update.status = "<running|ok|error>: <detail>"
# The service installs that one file, only as an update of sh.edm.s1kiosk, and nothing else; any
# app able to start it can only make it install what the kiosk itself staged.
service s1kiosk_update /system/bin/sh ${MAGISKTMP}/s1kiosk_update.sh
    user root
    group root system
    seclabel u:r:su:s0
    oneshot
    disabled

# Detection: a disabled service has no init.svc.* property until it first runs, so init announces
# it here. The app falls back to Android's PackageInstaller (confirmation on screen) without it.
on property:sys.boot_completed=1
    setprop sys.s1kiosk.update.version 1
