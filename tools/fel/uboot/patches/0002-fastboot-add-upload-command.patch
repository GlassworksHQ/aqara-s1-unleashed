index 9a2e9850..cd4e1def 100644
--- a/drivers/usb/gadget/f_fastboot.c
+++ b/drivers/usb/gadget/f_fastboot.c
@@ -21,6 +21,7 @@
 #include <linux/usb/composite.h>
 #include <linux/compiler.h>
 #include <g_dnl.h>
+#include <fastboot-internal.h>
 
 #define FASTBOOT_INTERFACE_CLASS	0xff
 #define FASTBOOT_INTERFACE_SUB_CLASS	0x42
@@ -497,6 +498,29 @@ static void do_bootm_on_complete(struct usb_ep *ep, struct usb_request *req)
 }
 #endif
 
+static u32 ul_sent;
+
+/* "upload": stream fastboot_upload_size bytes of the staging buffer, then OKAY. */
+static void tx_handler_ul_data(struct usb_ep *ep, struct usb_request *req)
+{
+	u32 left, n;
+
+	if (req->status) {
+		pr_err("upload: status %d\n", req->status);
+		fastboot_func->in_req->complete = fastboot_complete;
+		return;
+	}
+	left = fastboot_upload_size - ul_sent;
+	if (!left) {
+		fastboot_func->in_req->complete = fastboot_complete;
+		fastboot_tx_write_str("OKAY");
+		return;
+	}
+	n = left > EP_BUFFER_SIZE ? EP_BUFFER_SIZE : left;
+	fastboot_tx_write((const char *)fastboot_buf_addr + ul_sent, n);
+	ul_sent += n;
+}
