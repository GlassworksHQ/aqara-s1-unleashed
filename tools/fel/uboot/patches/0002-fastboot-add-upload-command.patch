@@ -324,6 +329,30 @@ static void getvar(char *cmd_parameter, char *response)
  * @cmd_parameter: Pointer to command parameter
  * @response: Pointer to fastboot response buffer
  */
+u32 fastboot_upload_size;
+
+/**
+ * upload() - Send the staging buffer to the host ("fastboot get_staged").
+ *
+ * @cmd_parameter: Unused
+ * @response: Pointer to fastboot response buffer
+ *
+ * Sends ${fastboot_upload_size} (hex) bytes from fastboot_buf_addr. Fill the buffer first, e.g.
+ * "oem run:mmc read <fastboot_buf_addr> <blk> <cnt>" then
+ * "oem run:setexpr fastboot_upload_size <cnt> * 200".
+ */
+static void upload(char *cmd_parameter, char *response)
+{
+	ulong size = env_get_hex("fastboot_upload_size", 0);
+
+	if (!size || size > fastboot_buf_size) {
+		fastboot_fail("set fastboot_upload_size (1..buffer size)", response);
+		return;
+	}
+	fastboot_upload_size = size;
+	fastboot_response("DATA", response, "%08lx", size);
+}
