CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-a133-aqara-s1-plus"
CONFIG_SPL=y
CONFIG_MACH_SUN50I_A133=y
# DDR4, values from the stock boot0 header (eGON.BT0 + 0x38) on this board
CONFIG_SUNXI_DRAM_A133_DDR4=y
CONFIG_DRAM_CLK=792
CONFIG_DRAM_SUNXI_DX_ODT=0x3030303
CONFIG_DRAM_SUNXI_DX_DRI=0xc0c0c0c
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_PARA0=0x12131615
CONFIG_DRAM_SUNXI_MR11=0x0
CONFIG_DRAM_SUNXI_MR12=0x0
CONFIG_DRAM_SUNXI_MR13=0x0
CONFIG_DRAM_SUNXI_MR14=0x0
CONFIG_DRAM_SUNXI_MR22=0x0
CONFIG_DRAM_SUNXI_TPR0=0x0
CONFIG_DRAM_SUNXI_TPR1=0x0
CONFIG_DRAM_SUNXI_TPR2=0x0
CONFIG_DRAM_SUNXI_TPR6=0xa000
CONFIG_DRAM_SUNXI_TPR10=0x2f7777
CONFIG_DRAM_SUNXI_TPR11=0xf101511
CONFIG_DRAM_SUNXI_TPR12=0xf0f1512
CONFIG_DRAM_SUNXI_TPR13=0x101d00
CONFIG_DRAM_SUNXI_TPR14=0x19191c1c
# PMIC: AXP806 on R_I2C @0x36. Mainline only allows AXP305_POWER on H616, so this resolves to
# SUNXI_NO_PMIC: SPL writes NO PMIC registers and every rail stays at its power-on default.
# Measured on the running stock system: DCDC-D (DDR4 VDD) 1.2 V, DCDC-E (eMMC/UART IO) 3.3 V.
# If enabling PMIC support later, DCDC4 (= DCDC-D) MUST be 1200: mainline's AXP305 default is 1500.
CONFIG_R_I2C_ENABLE=y
CONFIG_SPL_I2C=y
CONFIG_SPL_SYS_I2C_LEGACY=y
CONFIG_SYS_I2C_MVTWSI=y
CONFIG_SYS_I2C_SLAVE=0x7f
CONFIG_SYS_I2C_SPEED=400000
# eMMC on mmc2
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_SUPPORT_EMMC_BOOT=y
# Never autoboot from this U-Boot: it exists for recovery/provisioning.
CONFIG_BOOTDELAY=2
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
CONFIG_SPL_SHOW_ERRORS=y
CONFIG_SYS_CLK_FREQ=408000000
# Fastboot over the USB-C (OTG) port; autostarts after 2 s, interruptible on the UART.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fastboot usb 0"
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x50000000
CONFIG_FASTBOOT_BUF_SIZE=0x20000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=1
# Never save U-Boot's environment: the panel's "env" partition belongs to stock Android.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_MMC is not set
