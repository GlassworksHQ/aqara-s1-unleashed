index 52255f2..2a003df 100644
--- a/bl31/aarch64/bl31_entrypoint.S
+++ b/bl31/aarch64/bl31_entrypoint.S
@@ -27,6 +27,10 @@
 	 */
 
 func bl31_entrypoint
+	/* S1DBG: raw '@' to UART0 THR */
+	mov_imm	x9, 0x05000000
+	mov	w10, #0x40
+	str	w10, [x9]
 	/* ---------------------------------------------------------------
 	 * Stash the previous bootloader arguments x0 - x3 for later use.
 	 * ---------------------------------------------------------------
@@ -35,6 +39,21 @@ func bl31_entrypoint
 	mov	x21, x1
 	mov	x22, x2
 	mov	x23, x3
+	/* S1: sunxi-fel's RMR warm reset resets only the core, so the L2 can hold
+	 * stale (speculatively filled) lines for DRAM. Invalidate all levels. */
+	/* S1 test: run with the I-cache off (no cache-line instruction fills) */
+	mrs	x9, sctlr_el3
+	bic	x9, x9, #(1 << 12)
+	msr	sctlr_el3, x9
+	isb
+	mov	x0, #DCISW
+	bl	dcsw_op_all
+	ic	iallu
+	dsb	sy
+	isb
+	mov_imm	x9, 0x05000000
+	mov	w10, #0x49
+	str	w10, [x9]
 
